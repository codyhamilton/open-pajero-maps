+/* plan 63 source-tag sidecar (throwaway; output-neutral): KW_SIDECAR_DIR set ->
+ * one line per routed item and per receiving cell, per pid/tid file. */
+static __thread int g_sc_fd = -2;
+static void sc_line(const char *fmt, long long a, long long b, long long c, long long d,
+                    long long e, long long f, long long g) {
+    if (g_sc_fd == -2) {
+        const char *dir = getenv("KW_SIDECAR_DIR");
+        g_sc_fd = -1;
+        if (dir) {
+            char path[4096];
+            snprintf(path, sizeof path, "%s/e2_%d_%ld.tsv", dir, (int)getpid(),
+                     (long)syscall(SYS_gettid));
+            g_sc_fd = open(path, O_WRONLY | O_CREAT | O_APPEND, 0644);
+        }
+    }
+    if (g_sc_fd < 0) return;
+    char buf[256];
+    int n = snprintf(buf, sizeof buf, fmt, a, b, c, d, e, f, g);
+    if (n > 0 && write(g_sc_fd, buf, (size_t)n) < 0) { /* sidecar only */ }
+}
+extern __thread int kw__sc_on;
+extern __thread int64_t *kw__sc_ent;
+extern __thread int64_t kw__sc_n;
+static uint64_t sc_hash(const uint8_t *p, int64_t n) {
+    uint64_t h = 1469598103934665603ULL;
+    for (int64_t i = 0; i < n; i++) { h ^= p[i]; h *= 1099511628211ULL; }
+    return h;
+}
+/* tag line + the last enc_bg's entries; map (optional) = sub-record bg j -> parent i */
+static void sc_ents(const char *tag, long long lv, long long ix, long long iy, long long cell,
+                    const uint8_t *fr, int64_t flen, const int32_t *map) {
+    if (g_sc_fd == -2) sc_line("", 0, 0, 0, 0, 0, 0, 0);
+    if (g_sc_fd < 0) return;
+    size_t cap = 128 + (size_t)(kw__sc_n > 0 ? kw__sc_n : 0) * 24;
+    char *b = malloc(cap);
+    if (!b) return;
+    size_t m = (size_t)snprintf(b, cap, "%s\t%lld\t%lld\t%lld\t%lld\t%lld\t%016llx\t", tag, lv,
+                                ix, iy, cell, (long long)flen,
+                                (unsigned long long)sc_hash(fr, flen));
+    if (kw__sc_n < 0) m += (size_t)snprintf(b + m, cap - m, "OOM");
+    for (int64_t q = 0; q + 2 < kw__sc_n; q += 3) {
+        long long i = kw__sc_ent[q];
+        if (map) i = map[i];
+        m += (size_t)snprintf(b + m, cap - m, "%s%lld:%lld:%lld", q ? "," : "", i,
+                              (long long)kw__sc_ent[q + 1], (long long)kw__sc_ent[q + 2]);
+    }
+    b[m++] = '\n';
+    if (write(g_sc_fd, b, m) < 0) { /* sidecar only */ }
+    free(b);
+}
 
