+static uint64_t sc_hash(const uint8_t *p, int64_t n) {
+    uint64_t h = 1469598103934665603ULL;
+    for (int64_t i = 0; i < n; i++) { h ^= p[i]; h *= 1099511628211ULL; }
+    return h;
+}
+/* plan 64: stage entries of the last enc_bg; map (optional) = sub-record bg j -> parent i */
+static void st_ents(const char *tag, long long lv, long long ix, long long iy, long long cell,
+                    const uint8_t *fr, int64_t flen, const int32_t *map) {
+    if (g_sc_fd == -2) sc_line("", 0, 0, 0, 0, 0, 0, 0);
+    if (g_sc_fd < 0) return;
+    size_t cap = 128 + (size_t)(kw__st_n > 0 ? kw__st_n : 0) * 22;
+    char *b = malloc(cap);
+    if (!b) return;
+    size_t m = (size_t)snprintf(b, cap, "%s\t%lld\t%lld\t%lld\t%lld\t%lld\t%016llx\t", tag, lv,
+                                ix, iy, cell, (long long)flen,
+                                (unsigned long long)sc_hash(fr, flen));
+    if (kw__st_n < 0) m += (size_t)snprintf(b + m, cap - m, "OOM");
+    for (int64_t q = 0; q + KW_ST_W <= kw__st_n; q += KW_ST_W) {
+        long long i = kw__st_ent[q];
+        if (map) i = map[i];
+        m += (size_t)snprintf(b + m, cap - m, "%s%lld", q ? "," : "", i);
+        for (int k = 1; k < KW_ST_W; k++)
+            m += (size_t)snprintf(b + m, cap - m, ":%lld", (long long)kw__st_ent[q + k]);
+    }
+    b[m++] = '\n';
+    if (write(g_sc_fd, b, m) < 0) { /* sidecar only */ }
+    free(b);
+}
