# Original disc dump and any derived binary data
original-disc/

# Archived third-party reference spec (large PDFs, not our content)
spec/

# Cloned/built external reference tools (not our source)
tools/kiwiread/

# Build artifacts
*.o
*.iso
__pycache__/
*.pyc

# OSM source extracts (large, re-downloadable, not our content)
*.osm.pbf

# Regenerable script logs
tag_crosstab.out
tag_crosstab.err

# Pipeline output (regenerable from PBF + build_alldata.py)
output/

# C cell encoder, built on demand from parser/kiwiw/_cenc.c (see docs/provenance.md)
parser/kiwiw/_cenc.so

# Contract-T C build products (built on demand by parser/kiwiw/cbuild.py, see
# docs/provenance.md): the extension's content-hash stamp, and the layer (b)
# C unit-test binary + its content-hash stamp.
parser/kiwiw/_cenc.so.hash
parser/kiwiw/ctest/_ctest_bin
parser/kiwiw/ctest/_ctest_bin.hash
